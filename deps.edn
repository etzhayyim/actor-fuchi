;; fuchi — dual layout classpath
;; - Local / agent WIP: methods/ at repo root (+ self-symlink fuchi/ → .)
;; - GitHub main tip: src/fuchi/methods/ (ns still fuchi.methods.*)
;; nbb: nbb -cp . methods/… or nbb -cp '.:src' …
{:paths ["src" "."]
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main" "--lint" "src" "test" "methods" "--fail-level" "error"]}}}
